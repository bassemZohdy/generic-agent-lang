# ==============================================================================
# generic-agent-lang Environment Configuration
# ==============================================================================

# Application identity
APP_NAME=generic_agent
APP_VERSION=0.1.0
DEPLOYMENT_ENV=docker-compose

# Model configuration (prefix with provider, e.g. openai/gpt-4o, anthropic/claude-3-5-sonnet-latest)
AGENT_MODEL=openai/gpt-4o
LIVE_AGENT_MODEL=openai/gpt-4o

# Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=

# Local / Self-Hosted LLMs
OLLAMA_API_BASE=http://host.docker.internal:11434

# Use Case Selection: assistant, pipeline, multi_perspective, refine_until_good, expert_dispatch, team_coordinator, plan_and_execute, approval_gate
AGENT_USE_CASE=assistant

# Tools configuration (comma-separated: knowledge,search,mcp,openapi,approval,runtime,structured_output,skills,code_execution)
AGENT_TOOLS=knowledge,search,mcp,openapi,approval,runtime,structured_output
AGENT_KNOWLEDGE_FILE=
AGENT_SKILLS_DIR=./skills

# Code Execution Sandbox Strategy: docker_container, unsafe_local, unavailable
AGENT_CODE_EXECUTION_STRATEGY=docker_container
AGENT_CODE_EXECUTION_DOCKER_IMAGE=python:3.13-slim

# Authentication & Keycloak (Set AUTH_DISABLED=true for local evaluation)
AUTH_DISABLED=true
DEMO_MODE=true
KEYCLOAK_ISSUER=http://localhost:8080/realms/basic-agent
KEYCLOAK_AUDIENCE=basic-agent
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-production

# Observability
GRAFANA_ADMIN_PASSWORD=change-me-in-production
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
